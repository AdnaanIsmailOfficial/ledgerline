# Ledgerline runs with no configuration at all. Every value below is optional.
# Copy this file to .env.local to change a setting.

# Provider keys. When a provider's key is missing, requests for its models are
# answered by the built-in mock so the demo works with zero setup.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where the SQLite audit log lives.
LEDGERLINE_DB_PATH=./data/ledgerline.db

# Folder holding one YAML policy file per app.
LEDGERLINE_POLICY_DIR=./policies

# A Merkle checkpoint is written every N audit records.
LEDGERLINE_CHECKPOINT_INTERVAL=50
